table Fact_Sales
	lineageTag: 5a75fdf4-dfd7-4bf2-877a-ab1ea379b10c

	measure 'Total Sales' =
			
			SUM(Fact_Sales[sales_amount])
		lineageTag: 3d2e9e72-e4f4-486e-ad7f-b271a2636fb4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales MoM Growth %' =
			
			VAR CurrentSales =
			    [Total Sales]
			VAR PreviousSales =
			    CALCULATE(
			        [Total Sales],
			        DATEADD(Dim_Date[date], -1, MONTH)
			    )
			RETURN
			    DIVIDE(
			        CurrentSales - PreviousSales,
			        PreviousSales
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1dbea202-f875-4234-8ab1-493004545a9f

	column sale_id
		dataType: int64
		formatString: 0
		lineageTag: eaf8350e-d551-43e1-af37-0cb5f84a8ac7
		summarizeBy: sum
		sourceColumn: sale_id

		annotation SummarizationSetBy = Automatic

	column date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 00787f3e-65d8-4bcf-a55b-84718c95e449
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column city
		dataType: string
		lineageTag: 7beb1b4c-4851-4bca-8734-7b2376152c17
		summarizeBy: none
